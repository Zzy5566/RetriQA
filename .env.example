# ================= RetriQA 配置 =================
# 离线优先：默认 MOCK_MODE=true（确定性嵌入 + Mock LLM），零 key 可跑通整条链路。
# 接入真实模型时：MOCK_MODE=false + 填下面的 OpenAI 兼容接口（如硅基流动）。

MOCK_MODE=true

# ----- LLM（聊天生成）-----
LLM_API_BASE=https://api.siliconflow.cn/v1
LLM_API_KEY=
LLM_MODEL=Qwen/Qwen3-32B

# ----- Embedding（向量化）-----
# 留空则复用 LLM_API_BASE / LLM_API_KEY
EMBEDDING_API_BASE=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=BAAI/bge-m3

# ----- RAG 参数 -----
CHUNK_SIZE=500
CHUNK_OVERLAP=50
TOP_K=5
MAX_ATTEMPTS=2          # Self-RAG 纠正循环的最大轮数
CHROMA_DIR=./chroma_data

# ----- 服务 -----
HOST=127.0.0.1
PORT=8100